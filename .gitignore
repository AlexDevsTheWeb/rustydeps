# Rust build artifacts
/target/
**/*.rs.bk

# Local agent/tool scratch space (work journals, etc.) — never committed
/tmp/

# Local BYOK config may contain API keys — never committed
.rustydeps.json

# Generated reports and local HTML output
/reports/
/rustydeps-report.html

!doc/**/*.html
# Askama report template (source, not generated output)
!templates/**/*.html
# Raw Stitch design export kept as a reference input
!src/templates/**/*.html

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp
